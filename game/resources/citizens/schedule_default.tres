[gd_resource type="Resource" script_class="ScheduleData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/schedule_data.gd" id="1_sched"]
[ext_resource type="Script" path="res://scripts/data/schedule_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_night"]
script = ExtResource("2_entry")
label = "Night"
start_hour = 22.5
end_hour = 7.0
need_weights = {
1: 4.0,
4: 0.3,
5: 0.3,
0: 0.6
}

[sub_resource type="Resource" id="Resource_morning"]
script = ExtResource("2_entry")
label = "Morning"

}

[resource]
script = ExtResource("1_sched")
id = &"schedule_default"
display_name = "Ordinary day"
description = "Sleeps at night, eats at the usual hours, relaxes in the evening."
entries = Array[Resource]([SubResource("Resource_night"), SubResource("Resource_morning"), SubResource("Resource_daytime"), SubResource("Resource_lunch"), SubResource("Resource_afternoon"), SubResource("Resource_dinner"), SubResource("Resource_evening")])

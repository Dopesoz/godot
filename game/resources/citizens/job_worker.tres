[gd_resource type="Resource" script_class="JobData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/job_data.gd" id="1_job"]

[resource]
script = ExtResource("1_job")
id = &"worker"
display_name = "Worker"
description = "General labour. Long hours, modest pay, no qualifications required."
placeholder_color = Color(0.74, 0.6, 0.35, 1)

class_name GameLaunch
extends RefCounted

## Намерение, с которым запускается игровая сцена.
##
## Заглавный экран и игра — разные сцены, и передать между ними «продолжить
## или начать заново» иначе нечем: смена сцены не принимает аргументов.
## Статическое поле здесь честнее автозагрузки: это одно значение, живущее
## ровно один переход, и его видно целиком в одном файле.

## true — начать новую партию, даже если сохранение есть.
static var fresh_start: bool = false


## Считывает намерение и сразу его сбрасывает: следующий запуск игры из меню
## не должен неожиданно стереть прогресс.
static func take_fresh_start() -> bool:
	var value: bool = fresh_start
	fresh_start = false
	return value

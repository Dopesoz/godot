class_name Constants
extends RefCounted

## Глобальные константы проекта. Класс не инстанцируется — только статические данные.
## Держим здесь всё, что должно быть одинаковым для всех подсистем,
## чтобы избежать «магических чисел» в коде.

## --- Мир -------------------------------------------------------------------

## Размер одной клетки в пикселях (пиксель-арт, кратно 16).
const TILE_SIZE: int = 16
## Размер чанка в клетках. Чанк — единица генерации, отрисовки и сохранения.
const CHUNK_SIZE: int = 16
## Размер мира в чанках (квадрат). 32 * 16 = 512 клеток по стороне.
const WORLD_CHUNKS: int = 32
## Размер мира в клетках.
const WORLD_SIZE: int = WORLD_CHUNKS * CHUNK_SIZE

## --- Игровой цикл ----------------------------------------------------------

## Частота логического тика (Гц). Вся симуляция детерминирована и не зависит от FPS.
const TICKS_PER_SECOND: int = 10
const TICK_DELTA: float = 1.0 / float(TICKS_PER_SECOND)
## Предохранитель: сколько тиков максимум догоняем за один кадр (защита от «спирали смерти»).
const MAX_CATCHUP_TICKS: int = 5

## --- Камера ----------------------------------------------------------------

## Минимальный зум — ровно один экранный пиксель на пиксель арта. Дальше
## отдалять нельзя: пиксель-арт замыливается, а поле зрения раздувается
## настолько, что стриминг чанков перестаёт окупаться.
const CAMERA_ZOOM_MIN: float = 1.0
const CAMERA_ZOOM_MAX: float = 4.0
const CAMERA_ZOOM_DEFAULT: float = 2.0

## --- Ввод ------------------------------------------------------------------

## Порог в пикселях, после которого касание считается перетаскиванием, а не тапом.
const TOUCH_DRAG_THRESHOLD: float = 12.0
## Длительность удержания для «долгого нажатия», секунды.
const TOUCH_LONG_PRESS_TIME: float = 0.45

## --- Сохранение ------------------------------------------------------------

const SAVE_DIR: String = "user://saves"
const SAVE_FILE: String = "user://saves/slot0.json"
const SAVE_FORMAT_VERSION: int = 1


func _init() -> void:
	assert(false, "Constants — статический класс, не создавайте экземпляры.")

## Текст финала: показывается, когда сигнал ушёл.
const ENDING_TITLE: String = "Сигнал ушёл"
const ENDING_TEXT: String = (
	"Антенна выдала импульс, который услышат за десяток световых лет."
	+ " Ответ придёт нескоро, но фабрика останется работать и без вас:"
	+ " буры гудят, дроны развозят ящики, печи светят в темноте."
	+ "\n\nВы построили то, что переживёт ожидание. Игра пройдена —"
	+ " можно остаться и достроить всё, что задумывалось."
)


static func chapter_count() -> int:
	return CHAPTERS.size()


static func chapter_at(index: int) -> Dictionary:
	if index < 0 or index >= CHAPTERS.size():
		return {}
	return CHAPTERS[index]


static func index_of(chapter_id: StringName) -> int:
	for i: int in CHAPTERS.size():
		if CHAPTERS[i]["id"] == chapter_id:
			return i
	return -1

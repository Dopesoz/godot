class_name TritiumPlant
extends ProductionBuilding

## Тритиевый завод: выделяет тритий из воды.
##
## Отдельная машина, а не рецепт сборщика, по двум причинам. Во-первых, вода
## наконец получает вторую роль после котлов — иначе водоём остаётся
## декорацией. Во-вторых, у завода собственный класс машин, поэтому в него
## нельзя случайно поставить производство шестерёнок и удивиться, куда делся
## тритий.

func machine_kind() -> int:
	return Recipes.Machine.TRITIUM_PLANT

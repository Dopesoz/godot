; Engine configuration file.
; Drone Factory - mobile automation game.
;
; Format documentation: https://docs.godotengine.org/en/stable/tutorials/scripting/singletons_autoload.html

config_version=5

[application]

config/name="Drone Factory"
config/description="Мобильная игра про автоматизацию производства: буры, печи, электричество и дроны."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.06, 0.09, 1)

[autoload]

Events="*res://src/core/event_bus.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
; Экспорт Android пишет это значение в манифест как android:resizeableActivity.
; С resizeable=true система на больших экранах и в многооконном режиме
; игнорирует блокировку ориентации, и игра открывается «поперёк».
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30
2d/run_on_separate_thread=false
3d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
